<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>UNN Computer Based Test - CSC 222</title>
<style>
:root{--g:#0b6b3a;--g2:#e6f4ec;--gold:#ffffff;--ink:#14201a;--mut:#5b6b62;--line:#d2e2d8;--red:#b3261e;--bg:#f4f8f5;--amber:#b26a00}
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.5}
header{background:var(--g);border-bottom:4px solid var(--gold);color:#fff;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;position:sticky;top:0;z-index:5}
header h1{font-size:16px;margin:0;font-weight:700}
header small{opacity:.85;display:block;font-weight:400;font-size:12px}
#timer{font-variant-numeric:tabular-nums;font-weight:700;font-size:20px;background:rgba(255,255,255,.15);padding:4px 12px;border-radius:8px}
#timer.low{background:var(--red);animation:p 1s infinite}
@keyframes p{50%{opacity:.6}}
main{max-width:860px;margin:0 auto;padding:16px}
.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px;margin-bottom:16px}
h2{margin:0 0 12px;font-size:20px}
label{display:block;font-weight:600;margin:14px 0 6px}
input[type=text]{width:100%;padding:12px;border:1px solid #b9c8bf;border-radius:8px;font-size:16px}
input:focus{outline:2px solid var(--g);border-color:var(--g)}
button{font:inherit;cursor:pointer;border-radius:8px;border:1px solid var(--g);background:#fff;color:var(--g);padding:10px 16px;font-weight:600}
button.primary{background:var(--g);color:#fff}
button:disabled{opacity:.45;cursor:not-allowed}
.big{width:100%;padding:14px;font-size:17px;margin-top:18px}
ul.rules{padding-left:20px;color:var(--mut);margin:8px 0 0}
.err{color:var(--red);margin-top:10px;font-weight:600}
.qno{color:var(--mut);font-size:14px;margin-bottom:4px}
.qtext{font-size:18px;font-weight:600;margin-bottom:14px}
.opt{display:flex;gap:10px;align-items:flex-start;width:100%;text-align:left;border:1.5px solid var(--line);background:#fff;color:var(--ink);border-radius:10px;padding:12px;margin-bottom:10px;font-weight:500}
.opt:hover{border-color:var(--g)}
.opt.sel{border-color:var(--g);background:var(--g2)}
.opt b{min-width:22px;color:var(--g)}
.nav{display:flex;justify-content:space-between;gap:10px;margin-top:6px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(40px,1fr));gap:6px;margin-top:8px}
.grid button{padding:8px 0;font-size:14px;border-color:var(--line);color:var(--ink)}
.grid button.ans{background:var(--g2);border-color:var(--g)}
.grid button.cur{outline:2px solid var(--ink)}
.grid button.flag{background:#fff3d6;border-color:var(--amber)}
.score{text-align:center}
.score .n{font-size:56px;font-weight:800;color:var(--g);line-height:1}
.score .n.fail{color:var(--red)}
.pill{display:inline-block;padding:4px 12px;border-radius:99px;font-weight:700;font-size:14px;background:var(--g2);color:var(--g)}
.pill.fail{background:#fde8e6;color:var(--red)}
.rev{border-left:4px solid var(--red);padding:10px 14px;margin:12px 0;background:#fffafa;border-radius:6px}
.rev .y{color:var(--red)} .rev .c{color:var(--g);font-weight:600}
.legend{font-size:13px;color:var(--mut);display:flex;gap:12px;flex-wrap:wrap;margin-top:8px}
.hidden{display:none!important}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;padding:16px;z-index:10}
.modal .card{max-width:420px;margin:0}
</style>
</head>
<body>
<header>
  <h1>UNIVERSITY OF NIGERIA, NSUKKA<small id="who">Computer Based Test (CBT) | CSC 222: Principles of Crop Production</small></h1>
  <div id="timer" class="hidden">25:00</div>
</header>
<main>
 
<section id="login" class="card">
  <div style="text-align:center;margin-bottom:10px"><div style="font-weight:800;font-size:18px;color:var(--g)">UNIVERSITY OF NIGERIA, NSUKKA</div><div style="font-size:13px;color:var(--mut)">Computer Based Test (Practice) &bull; CSC 222 / ANS 274</div></div><h2>Candidate Login</h2>
  <ul class="rules">
    <li>70 questions, randomly picked for each student</li>
    <li>Time allowed: 25 minutes. The exam submits itself when time is up</li>
    <li>Do not refresh to cheat the clock: the timer keeps running</li>
  </ul>
  <label for="name">Full name</label>
  <input id="name" type="text" autocomplete="name" placeholder="e.g. Anyim Samuel Fabian">
  <label for="reg">Registration number</label>
  <input id="reg" type="text" autocomplete="off" placeholder="e.g. 2021/242123">
  <div id="lerr" class="err"></div>
  <button id="start" class="primary big">Login and Start Exam</button>
</section>
 
<section id="exam" class="hidden">
  <div class="card">
    <div class="qno" id="qno"></div>
    <div class="qtext" id="qtext"></div>
    <div id="opts"></div>
    <div class="nav">
      <button id="prev">&larr; Previous</button>
      <button id="flag">Flag</button>
      <button id="next" class="primary">Next &rarr;</button>
    </div>
  </div>
  <div class="card">
    <strong>Question navigator</strong> <span id="prog" style="color:var(--mut)"></span>
    <div class="grid" id="grid"></div>
    <div class="legend"><span>Green = answered</span><span>Yellow = flagged</span><span>White = not answered</span></div>
    <button id="submit" class="primary big">Submit Exam</button>
  </div>
</section>
 
<section id="result" class="hidden">
  <div class="card score">
    <div id="rname" style="font-weight:700"></div>
    <div id="rreg" style="color:var(--mut);margin-bottom:12px"></div>
    <div class="n" id="rscore"></div>
    <div id="rpct" style="margin:8px 0"></div>
    <span class="pill" id="rpill"></span>
    <div id="rmeta" style="color:var(--mut);margin-top:10px;font-size:14px"></div>
  </div>
  <div class="card">
    <h2>Questions you missed</h2>
    <div id="review"></div>
  </div>
  <button id="logout" class="big">Exit (next student)</button>
</section>
 
</main>
 
<div id="confirm" class="modal hidden"><div class="card">
  <h2>Submit exam?</h2>
  <p id="cmsg"></p>
  <div class="nav"><button id="cno">Go back</button><button id="cyes" class="primary">Yes, submit</button></div>
</div></div>
 
