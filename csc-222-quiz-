</script>
<script>
const TOTAL=70, MINUTES=25, PASS=50, KEY='cbt_session_v1';
const $=id=>document.getElementById(id);
let S=null, cur=0, tick=null;
 
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
function load(){try{return JSON.parse(localStorage.getItem(KEY))}catch(e){return null}}
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function show(id){['login','exam','result'].forEach(x=>$(x).classList.toggle('hidden',x!==id));$('timer').classList.toggle('hidden',id!=='exam')}
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
 
function start(){
  const name=$('name').value.trim().replace(/\s+/g,' '), reg=$('reg').value.trim();
  if(name.split(' ').length<2||name.length<5){return $('lerr').textContent='Please enter your full name (at least two names).'}
  if(!/^[\w\/\-\s]{6,20}$/.test(reg)||!/\d/.test(reg)){return $('lerr').textContent='Please enter a valid registration number.'}
  const n=Math.min(TOTAL,QUESTIONS.length);
  const ids=shuffle(QUESTIONS.map((_,i)=>i)).slice(0,n);
  // each question's options are shuffled once per student
  const order={};ids.forEach(i=>order[i]=shuffle([0,1,2,3]));
  S={name,reg,ids,order,ans:{},flags:{},end:Date.now()+MINUTES*60000,done:false};
  save();begin();
}
function begin(){
  $('who').textContent=S.name+' | '+S.reg;
  show('exam');cur=0;render();clearInterval(tick);tick=setInterval(clock,500);clock();
}
function clock(){
  const left=Math.max(0,S.end-Date.now());
  const m=Math.floor(left/60000),s=Math.floor(left%60000/1000);
  $('timer').textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
  $('timer').classList.toggle('low',left<=5*60000);
  if(left<=0){finish(true)}
}
function render(){
  const qi=S.ids[cur],q=QUESTIONS[qi],ord=S.order[qi];
  $('qno').textContent='Question '+(cur+1)+' of '+S.ids.length;
  $('qtext').textContent=q.q;
  $('opts').innerHTML=ord.map((oi,k)=>`<button class="opt ${S.ans[qi]===oi?'sel':''}" data-o="${oi}"><b>${'ABCD'[k]}.</b><span>${esc(q.o[oi])}</span></button>`).join('');
  $('opts').querySelectorAll('.opt').forEach(b=>b.onclick=()=>{S.ans[qi]=+b.dataset.o;save();render()});
  $('prev').disabled=cur===0;$('next').disabled=cur===S.ids.length-1;
  $('flag').textContent=S.flags[qi]?'Unflag':'Flag';
  const answered=S.ids.filter(i=>S.ans[i]!==undefined).length;
  $('prog').textContent=' ('+answered+'/'+S.ids.length+' answered)';
  $('grid').innerHTML=S.ids.map((i,k)=>`<button data-k="${k}" class="${S.ans[i]!==undefined?'ans':''} ${S.flags[i]?'flag':''} ${k===cur?'cur':''}">${k+1}</button>`).join('');
  $('grid').querySelectorAll('button').forEach(b=>b.onclick=()=>{cur=+b.dataset.k;render();window.scrollTo(0,0)});
}
function askSubmit(){
  const un=S.ids.filter(i=>S.ans[i]===undefined).length;
  $('cmsg').textContent=un?('You have '+un+' unanswered question(s). Submit anyway?'):'You have answered all questions. Submit now?';
  $('confirm').classList.remove('hidden');
}
function finish(auto){
  clearInterval(tick);$('confirm').classList.add('hidden');
  if(!S.done){S.done=true;S.submittedAt=Date.now();S.auto=!!auto;save()}
  result();
}
function result(){
  $('who').textContent=S.name+' | '+S.reg;
  let score=0,wrong=[];
  S.ids.forEach((qi,k)=>{ if(S.ans[qi]===0)score++; else wrong.push([k,qi]) });
  const n=S.ids.length,pct=Math.round(score/n*100),ok=pct>=PASS;
  $('rname').textContent=S.name;$('rreg').textContent=S.reg;
  $('rscore').textContent=score+' / '+n;$('rscore').classList.toggle('fail',!ok);
  $('rpct').textContent=pct+'%';
  $('rpill').textContent=ok?'PASS':'FAIL';$('rpill').classList.toggle('fail',!ok);
  const un=S.ids.filter(i=>S.ans[i]===undefined).length;
  $('rmeta').textContent='Correct: '+score+'  |  Wrong: '+(wrong.length-un)+'  |  Unanswered: '+un+(S.auto?'  |  Time was up, exam auto-submitted':'');
  $('review').innerHTML=wrong.length?wrong.map(([k,qi])=>{const q=QUESTIONS[qi],a=S.ans[qi];
    return `<div class="rev"><div><b>Q${k+1}.</b> ${esc(q.q)}</div><div class="y">Your answer: ${a===undefined?'Not answered':esc(q.o[a])}</div><div class="c">Correct answer: ${esc(q.o[0])}</div></div>`}).join(''):'<p>Perfect score. You did not miss any question.</p>';
  show('result');window.scrollTo(0,0);
}
$('start').onclick=start;
$('reg').addEventListener('keydown',e=>{if(e.key==='Enter')start()});
$('prev').onclick=()=>{cur--;render()};$('next').onclick=()=>{cur++;render()};
$('flag').onclick=()=>{const qi=S.ids[cur];S.flags[qi]=!S.flags[qi];save();render()};
$('submit').onclick=askSubmit;$('cno').onclick=()=>$('confirm').classList.add('hidden');$('cyes').onclick=()=>finish(false);
$('logout').onclick=()=>{try{localStorage.removeItem(KEY)}catch(e){}S=null;$('name').value='';$('reg').value='';$('who').textContent='Computer Based Test (CBT) | CSC 222: Principles of Crop Production';show('login')};
window.addEventListener('beforeunload',e=>{if(S&&!S.done){e.preventDefault();e.returnValue=''}});
(function init(){
  S=load();
  if(S&&Array.isArray(S.ids)){ if(S.done||Date.now()>=S.end){ if(!S.done){S.done=true;S.auto=true;save()} result() } else begin(); }
  else show('login');
})();
</script>
